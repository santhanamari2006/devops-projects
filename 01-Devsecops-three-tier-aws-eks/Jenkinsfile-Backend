pipeline {
    agent any

    tools {
        jdk 'jdk'
        nodejs 'nodejs'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'

        AWS_ACCOUNT_ID = credentials('ACCOUNT_ID')
        AWS_ECR_REPO_NAME = credentials('ECR_BACK')

        AWS_DEFAULT_REGION = 'ap-south-1'

        REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/"
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git(
                    branch: 'main',
                    credentialsId: 'github',
                    url: 'https://github.com/smarigurnathan/smari-three-tier-app.git'
                )
            }
        }

        stage('Sonarqube Analysis') {
            steps {
                dir('Three-Tier-DevSecOps-main/Application-Code/backend') {
                    withSonarQubeEnv('sonar-server') {
                        sh '''
                            $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectName=three-tier-back \
                            -Dsonar.projectKey=three-tier-back
                        '''
                    }
                }
            }
        }

        stage('Quality Check') {
            steps {
                script {
                    waitForQualityGate(
                        abortPipeline: false,
                        credentialsId: 'sonar-key'
                    )
                }
            }
        }

        stage('OWASP Dependency-Check Scan') {
            steps {

                /*
                 * If NVD is temporarily unavailable, the pipeline
                 * continues and marks this stage UNSTABLE.
                 */
                catchError(
                    buildResult: 'SUCCESS',
                    stageResult: 'UNSTABLE'
                ) {

                    dir('Three-Tier-DevSecOps-main/Application-Code/backend') {

                        withCredentials([
                            string(
                                credentialsId: 'NVD_API_KEY',
                                variable: 'NVD_KEY'
                            )
                        ]) {

                            dependencyCheck(
                                odcInstallation: 'DP-Check',
                                additionalArguments: """
                                    --scan ./
                                    --disableYarnAudit
                                    --disableNodeAudit
                                    --nvdApiKey ${NVD_KEY}
                                    --nvdApiDelay 10000
                                """.trim()
                            )
                        }

                        dependencyCheckPublisher(
                            pattern: '**/dependency-check-report.xml'
                        )
                    }
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir('Three-Tier-DevSecOps-main/Application-Code/backend') {
                    sh '''
                        trivy fs . > trivyfs.txt
                    '''
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                script {
                    dir('Three-Tier-DevSecOps-main/Application-Code/backend') {

                        sh '''
                            docker system prune -f
                        '''

                        sh '''
                            docker container prune -f
                        '''

                        sh '''
                            docker build -t ${AWS_ECR_REPO_NAME} .
                        '''
                    }
                }
            }
        }

        stage('ECR Image Pushing') {
            steps {
                script {

                    sh '''
                        aws ecr get-login-password \
                        --region ${AWS_DEFAULT_REGION} |
                        docker login \
                        --username AWS \
                        --password-stdin ${REPOSITORY_URI}
                    '''

                    sh '''
                        docker tag \
                        ${AWS_ECR_REPO_NAME} \
                        ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}
                    '''

                    sh '''
                        docker push \
                        ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('TRIVY Image Scan') {
            steps {
                sh '''
                    trivy image \
                    ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER} \
                    > trivyimage.txt
                '''
            }
        }

        stage('Checkout Code') {
            steps {
                git(
                    branch: 'main',
                    credentialsId: 'github',
                    url: 'https://github.com/smarigurnathan/smari-three-tier-app.git'
                )
            }
        }

        stage('Update Deployment file') {

            environment {
                GIT_REPO_NAME = 'smari-three-tier-app'
                GIT_USER_NAME = 'smarigurnathan'
            }

            steps {

                dir('Three-Tier-DevSecOps-main/Kubernetes/Backend') {

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github',
                            usernameVariable: 'USERNAME',
                            passwordVariable: 'PASSWORD'
                        )
                    ]) {

                        sh '''
                            set +x

                            git config user.email "smari.gurunathan86@gmail.com"
                            git config user.name "smarigurnathan"

                            echo "Updating deployment to image version: ${BUILD_NUMBER}"

                            imageTag=$(grep -oP '(?<=backend:)[^ ]+' deployment.yaml)

                            echo "Current image tag: ${imageTag}"

                            sed -i "s|${AWS_ECR_REPO_NAME}:${imageTag}|${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}|" deployment.yaml

                            echo "Updated deployment.yaml:"
                            cat deployment.yaml

                            git add deployment.yaml

                            git commit \
                            -m "Update deployment Image to version ${BUILD_NUMBER}" \
                            || echo "No changes to commit"

                            git push \
                            https://${USERNAME}:${PASSWORD}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                            HEAD:main
                        '''
                    }
                }
            }
        }
    }

    post {

        success {
            echo '=========================================='
            echo ' Jenkins Pipeline Completed Successfully '
            echo '=========================================='
        }

        unstable {
            echo '=========================================='
            echo ' Jenkins Pipeline Completed with Warnings '
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo ' Jenkins Pipeline FAILED '
            echo '=========================================='
        }

        always {
            echo 'Jenkins Pipeline execution completed.'
        }
    }
}
